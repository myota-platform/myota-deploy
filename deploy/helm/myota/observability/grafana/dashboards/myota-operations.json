{"title":"MyOTA operations","uid":"myota-operations","schemaVersion":39,"editable":false,"tags":["myota","opentelemetry","real-data"],"panels":[{"type":"stat","title":"Users","targets":[{"expr":"myota_identity_users_total"}]},{"type":"stat","title":"Geo entities","targets":[{"expr":"myota_geodata_entities_total"}]},{"type":"stat","title":"QSOs","targets":[{"expr":"myota_activity_qsos_total"}]},{"type":"stat","title":"Participants","targets":[{"expr":"myota_activity_participants_total"}]},{"type":"timeseries","title":"Entity lifecycle","targets":[{"expr":"myota_geodata_entities_by_status_total","legendFormat":"{{status}}"}]},{"type":"timeseries","title":"Activity","targets":[{"expr":"myota_activity_qsos_total","legendFormat":"valid QSOs"},{"expr":"sum(myota_activity_activations_by_status_total)","legendFormat":"activations"}]},{"type":"timeseries","title":"Import and worker state","targets":[{"expr":"myota_geodata_import_runs_by_status_total","legendFormat":"geo imports {{status}}"},{"expr":"myota_activity_jobs_queued_total","legendFormat":"queued jobs"}]},{"type":"timeseries","title":"HTTP errors","targets":[{"expr":"sum by (service,status) (rate(myota_http_requests_total{status=~\"4..|5..\"}[5m]))"}]},{"type":"timeseries","title":"OTel request rate","targets":[{"expr":"sum by (service_name) (rate(myota_http_server_requests_total[5m]))"}]},{"type":"timeseries","title":"OTel latency p95","targets":[{"expr":"histogram_quantile(0.95,sum by (le,service_name) (rate(myota_http_server_duration_milliseconds_bucket[5m])))"}]}]}
